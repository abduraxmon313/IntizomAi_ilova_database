# ── Asosiy ──────────────────────────────────────────────────
# Railway Postgres plagini ulansa DATABASE_URL avtomatik beriladi: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/intizom_app
# Railway domeni avtomatik aniqlanadi (RAILWAY_PUBLIC_DOMAIN). O'z domeningiz bo'lsa:
PUBLIC_BASE_URL=https://intizom-app-production.up.railway.app
# Uzun tasodifiy qator (masalan: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=

# ── Google Sign-In ──────────────────────────────────────────
# Google Cloud Console → Credentials'dagi OAuth client ID'lar, vergul bilan:
# Web client (ilovada serverClientId), iOS client, Android client.
GOOGLE_CLIENT_IDS=1234-web.apps.googleusercontent.com,1234-ios.apps.googleusercontent.com,1234-android.apps.googleusercontent.com

# ── Sign in with Apple ──────────────────────────────────────
APPLE_BUNDLE_IDS=uz.intizomai.intizomAi
# Hisob o'chirilganda Apple ruxsatini bekor qilish uchun (App Store talabi, tavsiya etiladi):
# developer.apple.com → Keys → "Sign in with Apple" kaliti (.p8)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 fayl mazmuni; qator uzilishlarini \n bilan yozish mumkin
APPLE_PRIVATE_KEY=

# ── AI murabbiy ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── To'lov: bot backend (IntizomAi_Bot_Pro_Copy) ────────────
# Bot Railway manzili va bot tomonidagi PARTNER_APP_KEY / PARTNER_APP_SECRET bilan BIR XIL qiymatlar.
BILLING_BASE_URL=https://intizom-aibot-production.up.railway.app
BILLING_PARTNER_KEY=
BILLING_PARTNER_SECRET=

# ── Havolalar ───────────────────────────────────────────────
APP_STORE_URL=
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=uz.intizomai.intizom_ai

# ── Ixtiyoriy sozlamalar (default qiymatlar ko'rsatilgan) ───
# FREE_DAILY_PLAN_LIMIT=5
# FREE_HABIT_LIMIT=3
# FREE_GOAL_LIMIT=3
# FREE_AI_DAILY_LIMIT=3
# GROUP_CREATE_PREMIUM_ONLY=true
# MAX_MEMBERS_PER_GROUP=50
# MIN_AGE=13
# REFERRAL_ACTIVATION_DAYS=3
# RUN_JOBS=true

# ── Admin panel (/admin) ────────────────────────────────────
# Adminlar jadvali bo'sh bo'lsa shu login "Egasi" bo'lib yaratiladi.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Parolni tiklash: true qilib deploy qiling, kiring, keyin o'chiring.
# ADMIN_RESET_PASSWORD=false
